{
  "name": "tunhuo-moshi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "《囤货末世》—— 末日囤货手账 · 整理模拟（手机竖屏 H5）",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:style": "node scripts/check-style.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:registry": "vite-node scripts/check-registry.mjs",
    "check": "npm run typecheck && npm run check:style && npm run check:docs && npm run check:content && npm run check:batches && npm run check:registry && npm run test",
    "make-save": "vite-node scripts/make-save.mjs",
    "check:batches": "node scripts/check-batches.mjs",
    "make-perfect": "vite-node scripts/make-perfect-save.ts",
    "plan-perfect": "vite-node scripts/plan-perfect-save.ts",
    "check:docs": "node scripts/check-docs.mjs",
    "strip-trace": "node scripts/strip-trace.mjs"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
